{
  "title": {
    "by": "css",
    "selector": "input[name='title'],#Title",
    "field_type": "text"
  },
  "subtitle": {
    "by": "css",
    "selector": "input[name='subtitle']",
    "field_type": "text"
  },
  "description": {
    "by": "css",
    "selector": "textarea[name='description'],#Description",
    "field_type": "textarea"
  },
  "keywords": {
    "by": "css",
    "selector": "input[name='keywords']",
    "field_type": "text"
  },
  "manuscript_file": {
    "by": "css",
    "selector": "input[type='file'][name*='manuscript'],input[type='file'][accept*='epub']",
    "field_type": "file"
  },
  "cover_file": {
    "by": "css",
    "selector": "input[type='file'][accept*='image']",
    "field_type": "file"
  },
  "price": {
    "by": "css",
    "selector": "input[name='price']",
    "field_type": "text"
  }
}