{
  "title": "Hard-Fail 금지어/상투어 사전",
  "version": "1.0",
  "description": "AI 생성문 특유의 상투어·기계적 접속사. 본문에 박히면 출간 차단(또는 임계 초과 시 차단). lint_text.py가 소비.",
  "policy": "본문(body)에서 검출. 인용/예문은 예외 처리 가능.",
  "severity_rules": {
    "critical_terms_max": 0,
    "warn_terms_max_per_10k": 3,
    "note": "critical은 1회라도 검출 시 Hard-Fail. warn은 1만 자당 허용치 초과 시 Hard-Fail."
  },
  "critical": [
    "결론적으로 말하자면",
    "요약하자면",
    "요약하면",
    "종합하자면",
    "다양한 관점에서",
    "결론적으로 말해서",
    "강제접힘",
    "거짓 닫힘",
    "주지하다시피"
  ],
  "warn": [
    "결론적으로",
    "중요한 것은",
    "중요합니다",
    "~할 수 있습니다",
    "그러므로",
    "따라서",
    "즉,",
    "다시 말해",
    "본질적으로",
    "궁극적으로",
    "사실상",
    "기본적으로",
    "전반적으로",
    "~에 대해서",
    "~라고 할 수 있다",
    "~인 것이다",
    "되어집니다",
    "보여집니다",
    "생각되어집니다"
  ],
  "ai_cliche_patterns": [
    "이 (글|책|연구|장)은 (우리에게|독자에게) .{0,20}을(를)? 보여준다",
    "(매우|아주|정말|굉장히|너무) (중요|핵심)",
    "(\\S+)되어지(다|ㅂ니다|었)",
    "(\\S+)로 보여(진다|집니다)"
  ]
}
